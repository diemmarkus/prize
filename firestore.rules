rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own data.
    // Stonks keeps holdings here; prize keeps its watch list in users/{uid}/prize.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // prize: the public list of watched Geizhals products. The daily GitHub Action reads it
    // without signing in. It holds no user ids, only the product link, its name and the day
    // it was last opened. Signed-in users may add or refresh entries, never delete them.
    match /watched/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && id.matches('a[0-9]{3,10}')
        && request.resource.data.keys().hasOnly(['url', 'name', 'lastSeen'])
        && request.resource.data.url is string
        && request.resource.data.url.size() < 400
        && request.resource.data.url.matches('https://geizhals[.]at/.*')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.lastSeen is string
        && request.resource.data.lastSeen.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Everything else is closed.
  }
}
